<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Override the app label for the debug variant so it appears separately
         in the device launcher and is easy to distinguish from the release app.
         tools:replace tells the manifest merger this override is intentional. -->
    <application
        android:label="حسابات يومية (Debug)"
        tools:replace="android:label"/>
</manifest>
