{
  "package_name": "com.stcpay.apps",
  "wallet_name": "STC Pay",
  "rules": [
    {
      "identifier_regex": "تم استلام|وصلك مبلغ|إيداع",
      "transaction_type": "INCOMING",
      "parsers": {
        "amount": "مبلغ (\\d+\\.?\\d*)",
        "currency": "مبلغ \\d+\\.?\\d* (ريال|ر\\.س|SAR)",
        "counterpart": "من (?<value>[^\\.]+)",
        "reference_id": "رقم العملية (\\d+)"
      }
    },
    {
      "identifier_regex": "خصم|شراء|تحويل صادق",
      "transaction_type": "OUTGOING",
      "parsers": {
        "amount": "بقيمة (\\d+\\.?\\d*)",
        "currency": "بقيمة \\d+\\.?\\d* (ريال|ر\\.س|SAR)",
        "counterpart": "إلى (?<value>[^\\.]+)",
        "reference_id": "الرقم المرجعي (\\d+)"
      }
    }
  ]
}
